# Copy this file to .env and fill in your values. All keys are server-side only.

# ── Supabase ──────────────────────────────────────────────────────────────────
# Supabase dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── Admin operator account ────────────────────────────────────────────────────
# The single operator who can see the AI monitor at /admin. Sign in normally with
# this email/password (Supabase auth); the app recognises the email. See
# decision 014. Password is only used to log in as this account, not read by code.
ADMIN_EMAIL_001=you@example.com
ADMIN_PASSWORD_001=your-admin-password

# ── AI providers ──────────────────────────────────────────────────────────────
# Multi-provider routing engine (lib/ai/router.ts, decisions 013). Each model
# authenticates with its own key. See the router header for the failover lanes.
MISTRAL_MINISTRAL_8B_API_KEY=your-mistral-key          # ministral-8b-latest
DEEP_INFRA_API_KEY=your-deepinfra-key                  # one key, three model tiers on the reasoning pipeline (DEEPINFRA_MODEL=Qwen3-235B default/"draft", DEEPINFRA_LARGE_MODEL=Qwen3.8-2.4T-A95B for perspectives/global-assumptions, DEEPINFRA_CRITIC_MODEL=DeepSeek-V3 for review panels — see router-config.ts TARGETS.deepinfra* for the full history) — also the realtime lane's primary
GROQ_QWEN_3_POINT_6_27B_API_KEY=your-groq-qwen-key     # qwen/qwen3.6-27b
GROQ_OPENAI_GPT_OSS_20B_API_KEY=your-groq-gptoss-key   # openai/gpt-oss-20b
GEMINI_FLASH_2_POINT_5_API_KEY=your-gemini-key         # gemini-2.5-flash (~1M ctx)
CEREBRAS_GPT_OSS_120B_API_KEY=your-cerebras-key        # gpt-oss-120b (ultra-fast)
OPENROUTER_API_KEY=your-openrouter-key                 # daily-blackout airbag only

# Brave Search — evidence research. brave.com/search/api
BRAVE_SEARCH_API_KEY=your-brave-key

# ── Optional overrides (env wins over built-in defaults) ──────────────────────
# Model ids:  MISTRAL_MODEL / DEEPINFRA_MODEL / DEEPINFRA_LARGE_MODEL / DEEPINFRA_CRITIC_MODEL /
#             GROQ_QWEN_MODEL / GROQ_GPT_OSS_MODEL / GEMINI_FLASH_MODEL / CEREBRAS_GPT_OSS_MODEL /
#             OPENROUTER_FREE_MODEL
# Base URLs:  MISTRAL_BASE_URL / DEEPINFRA_BASE_URL / GROQ_BASE_URL / GEMINI_BASE_URL /
#             CEREBRAS_BASE_URL / OPENROUTER_BASE_URL
# Key env names: MISTRAL_KEY_ENV / DEEPINFRA_KEY_ENV / GROQ_QWEN_KEY_ENV / GROQ_GPT_OSS_KEY_ENV /
#             GEMINI_KEY_ENV / CEREBRAS_KEY_ENV / OPENROUTER_KEY_ENV
# Context windows (tokens, drive size-aware routing to Gemini):
#             MISTRAL_CONTEXT / DEEPINFRA_CONTEXT / GROQ_CONTEXT / GEMINI_CONTEXT /
#             CEREBRAS_CONTEXT / OPENROUTER_CONTEXT
# Concurrency: DEEPINFRA_MAX_CONCURRENT (default 20) — caps simultaneous
#             in-flight requests across ALL THREE DeepInfra tiers (one shared
#             account/key); excess calls queue FIFO instead of firing at once
#             and timing out together. See lib/ai/router-concurrency.ts.
